# PORT=4000

# # Max JSON body size (temple onboarding sends base64 images). Default 10mb when unset.
# # JSON_BODY_LIMIT=10mb

# # `.env` is read from this folder (omkaarya-test-backend/.env) via `src/load-env.ts`.
# # Migrations run automatically on server start unless NODE_ENV=production (use AUTO_MIGRATE=0 to disable in dev).
# # Migrations are schema-only — demo data is NOT inserted on server start. Run `npm run seed` manually when needed.

# # AUTO_MIGRATE=0

# # Use either DATABASE_URL or the discrete variables below (for `npm run migrate` / `npm run seed`).
# # `npm run seed` upserts demo users, temples, super-admin roles, deities, and testimonials (manual only).
# # `npm run seed:pricing-plans` upserts pricing plan rows separately.
# # DATABASE_URL=postgres://postgres:1234@localhost:5432/mydb

# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=mydb
# DB_PASS=
# DB_PORT=5432
#
# Temple operational databases (per temple) use the same PostgreSQL user/host/password/port as above.
# Only the database name differs: DB_NAME is the super-admin platform DB; each temple uses `operational_db_name` on that server.
# You may omit TEMPLE_OPS_DB_USER / TEMPLE_OPS_DB_HOST / etc. when they match DB_*.
# TEMPLE_OPS_PG_SUPERUSER_URL — optional superuser URL to maintenance DB `postgres` for CREATE DATABASE on temple creation.

# # Email (SMTP) — required to send temple invite + password reset OTP emails.
# #
# # Minimal:
# # EMAIL_FROM="Omkaarya <no-reply@example.com>"
# # SMTP_URL="smtp://user:pass@smtp.example.com:587"
# #
# # Or discrete config:
# # SMTP_HOST=smtp.example.com
# # SMTP_PORT=587
# # SMTP_SECURE=false
# # SMTP_USER=
# # SMTP_PASS=
# #
# # Optional app URL for the invite link (falls back to http://localhost:3000/temple-admin/signin):
# # TEMPLE_ADMIN_SIGNIN_URL=http://localhost:3000/temple-admin/signin
# # PUBLIC_APP_URL=http://localhost:3000
# # Required for invoice email/print logo (absolute URL to Next.js public assets).
# # PUBLIC_APP_URL=https://omkaarya.com
#
# # Optional absolute URL for invoice logo (overrides PUBLIC_APP_URL + /brand-logo/Omkaarya 9.svg).
# # BILLING_LOGO_URL=https://omkaarya.com/brand-logo/Omkaarya%209.svg
#
# # Billing issuer (invoice From block). Defaults to Omkaarya Platform when unset.
# # BILLING_ISSUER_NAME=Omkaarya Platform
# # BILLING_ISSUER_ADDRESS=14 Mandir Lane, London EC4A 4AB, United Kingdom
# # BILLING_ISSUER_EMAIL=billing@omkaarya.com
# # BILLING_ISSUER_WEBSITE=https://omkaarya.com
# # BILLING_BRAND_LINE=Temple management for the digital age
# # BILLING_CURRENCY=USD
# # BILLING_TAX_RATE_BPS=0
# # BILLING_TAX_LABEL=Tax
# # BILLING_PAYMENT_METHOD_LABEL=Bank transfer
# # BILLING_BANK_NAME=
# # BILLING_BANK_BRANCH=
# # BILLING_BANK_ACCOUNT_NAME=
# # BILLING_BANK_ACCOUNT_NUMBER=
# # BILLING_BANK_SWIFT=
# # BILLING_PAYMENT_NOTES=
#
# # CORS: exact browser origin(s) of the Next.js app. Comma-separated for production + Vercel previews.
# # CORS_ORIGIN=https://your-app.vercel.app,https://your-app-git-main-username.vercel.app

# # Cloudinary (required for temple payment slip uploads)
# # CLOUDINARY_CLOUD_NAME=
# # CLOUDINARY_API_KEY=
# # CLOUDINARY_API_SECRET=
# #
# # Optional folder (default: omkaarya/payments/temple-onboarding)
# # CLOUDINARY_FOLDER=omkaarya/payments/temple-onboarding
# #
# # Optional branding subfolders (defaults: omkaarya/branding/temple-logo, admin-profile, master-deity)
# # CLOUDINARY_BRANDING_TEMPLE_LOGO_FOLDER=omkaarya/branding/temple-logo
# # CLOUDINARY_BRANDING_ADMIN_PROFILE_FOLDER=omkaarya/branding/admin-profile
# # CLOUDINARY_BRANDING_MASTER_DEITY_FOLDER=omkaarya/branding/master-deity
#
# # --- Temple operational DB (one PostgreSQL database per temple) ---
# # Platform `temples` row: `operational_db_name` OR `operational_database_url`.
# # Default: reuse DB_HOST, DB_USER, DB_PASS, DB_PORT (same role; only database name changes per temple). Override only if needed:
# # TEMPLE_OPS_DB_HOST=localhost
# # TEMPLE_OPS_DB_USER=postgres
# # TEMPLE_OPS_DB_PASS=
# # TEMPLE_OPS_DB_PORT=5432
# #
# # CLI `npm run temple-ops:bootstrap` optional superuser for CREATE DATABASE:
# # TEMPLE_OPS_PG_SUPERUSER_URL=postgres://postgres:pass@localhost:5432/postgres
# #
# # Public marketing homepage: read the "Temple Dashboard" card from this tenant's operational DB
# # (after `npm run temple-ops:migrate-env` / migrations-temple-ops on that database, including 003_marketing_dashboard_card.sql).
# # When unset or ops DB unavailable, the API returns the same built-in defaults as the static UI.
# # PUBLIC_MARKETING_TEMPLE_OPS_TENANT_ID=1001
# #
# # Credential mirror: if 1, platform password updates fail when mirror sync fails:
# # TEMPLE_AUTH_SYNC_REQUIRED=0
# #
# # JWT must match Next.js `JWT_SECRET` (temple-admin inventory API verification):
# # JWT_SECRET=your-development-secret
#
# # --- Platform migration order (existing DBs) ---
# # After migration 024 runs, execute: npm run migrate:temple-admin-data-to-ops
# # Then apply 025 (drop legacy temple_payment_submissions) and 026 (drop moved columns from public.temples).

# Super-admin registration API (POST /api/super-admin/register)
# Required. Requests must include header: x-super-admin-register-token: <token>
# SUPER_ADMIN_REGISTER_TOKEN=change-me
