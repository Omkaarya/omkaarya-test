# PORT=4000

# # `.env` is read from this folder (omkaarya-test-backend/.env) via `src/load-env.ts`.
# # Migrations run automatically on server start unless NODE_ENV=production (use AUTO_MIGRATE=0 to disable in dev).

# # AUTO_MIGRATE=0

# # Use either DATABASE_URL or the discrete variables below (for `npm run migrate` / `npm run seed`).
# # `npm run seed` upserts demo rows in public.users for POST /api/login (e.g. invite@test.com / temp123).
# # DATABASE_URL=postgres://postgres:1234@localhost:5432/mydb

# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=mydb
# DB_PASS=
# DB_PORT=5432

# # Email (SMTP) — required to send temple invite + password reset OTP emails.
# #
# # Minimal:
# # EMAIL_FROM="Omkaarya <no-reply@example.com>"
# # SMTP_URL="smtp://user:pass@smtp.example.com:587"
# #
# # Or discrete config:
# # SMTP_HOST=smtp.example.com
# # SMTP_PORT=587
# # SMTP_SECURE=false
# # SMTP_USER=
# # SMTP_PASS=
# #
# # Optional app URL for the invite link (falls back to http://localhost:3000/temple-admin/signin):
# # TEMPLE_ADMIN_SIGNIN_URL=http://localhost:3000/temple-admin/signin
# # PUBLIC_APP_URL=http://localhost:3000
#
# # CORS: exact browser origin(s) of the Next.js app. Comma-separated for production + Vercel previews.
# # CORS_ORIGIN=https://your-app.vercel.app,https://your-app-git-main-username.vercel.app

# # Cloudinary (required for temple payment slip uploads)
# # CLOUDINARY_CLOUD_NAME=
# # CLOUDINARY_API_KEY=
# # CLOUDINARY_API_SECRET=
# #
# # Optional folder (default: omkaarya/payments/temple-onboarding)
# # CLOUDINARY_FOLDER=omkaarya/payments/temple-onboarding
# #
# # Optional branding subfolders (defaults: omkaarya/branding/temple-logo, omkaarya/branding/admin-profile)
# # CLOUDINARY_BRANDING_TEMPLE_LOGO_FOLDER=omkaarya/branding/temple-logo
# # CLOUDINARY_BRANDING_ADMIN_PROFILE_FOLDER=omkaarya/branding/admin-profile
